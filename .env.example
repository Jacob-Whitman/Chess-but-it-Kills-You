# copy me to .env

# openshock.app -> Settings -> API Tokens. only needs shockers.use
OPENSHOCK_API_TOKEN=paste-your-token-here
OPENSHOCK_API_URL=https://api.openshock.app

# python main.py --list-shockers
OPENSHOCK_SHOCKER_ID=00000000-0000-0000-0000-000000000000
# second shocker for OPPONENT=human games, leave blank otherwise
OPENSHOCK_SHOCKER_ID_OPPONENT=

# true = log only, nothing gets sent. or just run with --dry-run
DRY_RUN=false

# intensity 0-100 when you lose that piece
SHOCK_INTENSITY_PAWN=10
SHOCK_INTENSITY_KNIGHT=25
SHOCK_INTENSITY_BISHOP=25
SHOCK_INTENSITY_ROOK=40
SHOCK_INTENSITY_QUEEN=70
SHOCK_INTENSITY_CHECKMATE=100

# duration = base + per_point * piece value (pawn 1, N/B 3, R 5, Q 9). api minimum is 300
SHOCK_DURATION_BASE_MS=400
SHOCK_DURATION_PER_POINT_MS=150
SHOCK_DURATION_CHECKMATE_MS=3000

# check = vibrate. 0 to turn off
CHECK_VIBRATE_INTENSITY=35
CHECK_VIBRATE_DURATION_MS=500

# hard caps, applied after everything above. nothing ever goes above these
SHOCK_MAX_INTENSITY=50
SHOCK_MAX_DURATION_MS=2500

# white | black. online, the host plays this and the joiner gets the other one
PLAYER_COLOR=white
# ai | human. ignored when online
OPPONENT=ai
# 2 fast and dumb, 3 ok, 4 slow
AI_DEPTH=3
# optional, replaces the built-in ai
STOCKFISH_PATH=
STOCKFISH_SKILL_LEVEL=5
